DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/statement_analyzer
NEXTAUTH_SECRET=generate-a-random-32-char-secret-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
FRONTEND_URL=http://localhost:3000

# Local dev only: leave unset and run `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Production: paste the full contents of a GCP service-account JSON key here
# (one line). Required wherever there's no personal gcloud login available,
# e.g. Fly.io. See backend/DEPLOY.md for how to create the service account.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
