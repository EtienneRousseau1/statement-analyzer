DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/statement_analyzer
NEXTAUTH_SECRET=generate-a-random-32-char-secret-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FRONTEND_URL=http://localhost:3000

# Local dev only: leave unset and run `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Plaid (live bank connections). Leave blank to disable the feature entirely
# and keep statement uploads as the only way in.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://statement-analyzer-api.fly.dev/plaid/webhook
PLAID_REDIRECT_URI=https://statementanalyzer.vercel.app/plaid/oauth
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_MAX_ITEMS=10

# Production: paste the full contents of a GCP service-account JSON key here
# (one line). Required wherever there's no personal gcloud login available,
# e.g. Fly.io. See ../DEPLOY.md for how to create the service account.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
